/* Elixhauser comorbidity lookup dataset                         */
/* 31 categories, ICD-9-CM and ICD-10 code prefixes from the     */
/* Quan et al. (2005, Med Care 43:1130) Elixhauser algorithms,  */
/* as distributed in the R package comorbidity 1.1.0            */
/* (elixhauser_icd9_quan, elixhauser_icd10_quan).               */
/* Codes are prefixes: a claim code matches a category when any  */
/* of its leading substrings equals an entry of the same ICD     */
/* version (1_nstemi_episodes.sas expands each claim code to its  */
/* prefixes and joins exactly). A code may map to more than one  */
/* category (e.g., 40201 = chf + htn_cx).                        */

DATA WORK.Elix_Lookup;
    LENGTH ICD_Code $10 Comorbidity $15 ICD_Version 3;
    INPUT ICD_Version ICD_Code $ Comorbidity $;
    DATALINES;
